[Unit]
Description=NexusAudit Internal Key Management and Telemetry Microservice
After=network.target

[Service]
Type=simple
User=nexusaudit
Group=nexus
WorkingDirectory=/opt/nexus/internal_svc
Environment="PATH=/opt/nexus/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/nexus/venv/bin/python3 /opt/nexus/internal_svc/internal_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
