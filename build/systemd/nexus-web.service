[Unit]
Description=NexusAudit Public Compliance Web Application
After=network.target nexus-internal.service
Wants=nexus-internal.service

[Service]
Type=simple
User=nexusaudit
Group=nexus
WorkingDirectory=/opt/nexus/app
Environment="PATH=/opt/nexus/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/nexus"
ExecStart=/opt/nexus/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
